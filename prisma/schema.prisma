generator client {
  provider      = "prisma-client-js"
  // Añadimos compatibilidad para tu Docker (Alpine y Debian Slim)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model DocumentType {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  createdBy String?
  updatedBy String?

  BussinessPartner BussinessPartner[]
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model BussinessPartner {
  id             String        @id @default(uuid())
  type           PartnerType   @default(CUSTOMER) // Discriminator
  typeBP         String // Tipo de socio de negocio (persona, empresa, etc.)
  typeDocId      String?
  documentType   DocumentType? @relation(fields: [typeDocId], references: [id])
  documentNumber String?       @unique
  firstName      String?
  middleName     String?
  lastName       String?
  sex            String? // M/F or specific value
  surname        String?
  companyName    String?
  contactEmail   String?
  email          String        @unique
  phone          String?
  telephone      String?
  address        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  societyId      String
  society        Society       @relation(fields: [societyId], references: [id])

  // New Fields for Enhanced Business Partner Support
  tradeName String? // Nombre Comercial (distinct from companyName/Reason Social)
  website   String?

  // Tax Info (SUNAT)
  taxCondition String? // Habido, No Habido
  taxStatus    String? // Activo, Baja

  // Location
  ubigeoId String?     @db.Char(6)
  ubigeo   UbigeoPeru? @relation(fields: [ubigeoId], references: [id])

  isActive  Boolean    @default(true)
  isDeleted Boolean    @default(false)
  createdBy String?
  updatedBy String?
  Purchase  Purchase[]
  Order     Order[]

  OutgoingConsignmentAgreement OutgoingConsignmentAgreement[]

  // Reverse relation for Society's legal entity
  societyRepresented    Society?             @relation("SocietyLegalEntity")
  branchOfficeProduct   BranchOfficeProduct? @relation(fields: [branchOfficeProductId], references: [id])
  branchOfficeProductId String?
}

model Currency {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  symbol    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?
  createdBy String?

  // Custom Currency ownership
  societyId String?
  society   Society? @relation("SocietyCustomCurrency", fields: [societyId], references: [id])

  SocietyReceipt                 SocietyReceipt[]
  Order                          Order[]
  orderPayments                  OrderPayment[]
  societies                      Society[]                       @relation("SocietyMainCurrency")
  purchases                      Purchase[]
  outgoingConsignmentAgreements  OutgoingConsignmentAgreement[]
  receivedConsignmentSettlements ReceivedConsignmentSettlement[]
  cashMovements                  CashMovement[]
}

model File {
  id          String       @id @default(uuid())
  name        String
  path        String
  mimeType    String?
  size        Int?
  key         String?      @unique
  storageType StorageType  @default(LOCAL)
  category    FileCategory @default(GENERAL)

  uploadedAt DateTime  @default(now())
  expiresAt  DateTime? // Fecha de expiración para archivos temporales (REPORT)
  societyId  String
  society    Society   @relation(fields: [societyId], references: [id])

  // Relaciones
  uploadedById String?
  uploadedBy   String?

  Product Product[]

  orderPayments OrderPayment[]
  societyLogo   Society?         @relation("SocietyLogo")
  receiptPdf    SocietyReceipt[] @relation("ReceiptPdf")
  receiptXml    SocietyReceipt[] @relation("ReceiptXml")
}

enum StorageType {
  LOCAL
  S3
  EXTERNAL
}

enum FileCategory {
  GENERAL
  REPORT // Archivos temporales (ej: Excel, PDF) con política de retención
  // Se pueden agregar más categorías si es necesario
}

model Tax {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  value       Float // Porcentaje (ej. 18.0 para 18%)
  type        TaxType // Tipo de impuesto: porcentaje o fijo
  description String? // Descripción opcional
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  SocietyReceipt SocietyReceipt[]

  societies Society[]
  purchases Purchase[]
}

enum TaxType {
  percentage // Porcentaje, ej. 18%
  fixed // Monto fijo, ej. 5 USD
}

model ReceiptType {
  id             String           @id @default(uuid())
  code           String           @unique // Código SUNAT o equivalente (ej. 01, 03)
  name           String // Nombre descriptivo (Factura, Boleta, etc.)
  description    String? // Información adicional si se desea
  isElectronic   Boolean          @default(true) // Si es electrónico (e.g. para integración con SUNAT u otros)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  SocietyReceipt SocietyReceipt[]
  societies      Society[]
  purchases      Purchase[]
}

enum ReceiptStatus {
  issued // Emitido correctamente
  canceled // Anulado
  pending_send // Pendiente de envío a sistema externo (como SUNAT)
}

model Society {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  subscriptionId String   @unique
  createdBy      String?
  updatedBy      String?
  isActive       Boolean  @default(true)
  isDeleted      Boolean  @default(false)

  // Link to the BusinessPartner record that represents THIS Society
  legalEntityId String?           @unique
  legalEntity   BussinessPartner? @relation("SocietyLegalEntity", fields: [legalEntityId], references: [id])

  // Relaciones
  Product                      Product[]
  BranchOffice                 BranchOffice[]
  Purchase                     Purchase[]
  Order                        Order[]
  OutgoingConsignmentAgreement OutgoingConsignmentAgreement[]

  categories Category[]

  files File[]

  orderPayments OrderPayment[]

  bussinessPartners BussinessPartner[]

  favorites Favorite[]

  // Configuración Regional
  mainCurrencyId String?
  mainCurrency   Currency? @relation("SocietyMainCurrency", fields: [mainCurrencyId], references: [id])

  taxes            Tax[]
  customCurrencies Currency[]   @relation("SocietyCustomCurrency")
  receiptType      ReceiptType? @relation(fields: [receiptTypeId], references: [id])
  receiptTypeId    String?

  // Personalización / Branding
  logoId String? @unique
  logo   File?   @relation("SocietyLogo", fields: [logoId], references: [id])

  // Settings & Notifications
  stockNotificationFrequency Frequency @default(NEVER)
  salesNotificationFrequency Frequency @default(DAILY)
  backupFrequency            Frequency @default(NEVER)

  dataRetentionDays Int? // 30, 60, 90...

  // UI Customization (JSON)
  uiConfig        Json? // { theme: "dark", colors: {...}, fonts: "Inter" }
  societyReceipts SocietyReceipt[]
  cashShifts      CashShift[]

  // Catalogs
  unitOfMeasures UnitOfMeasure[]

  // Storage
  storageLimit BigInt @default(157286400) // 150MB in bytes (150 * 1024 * 1024)

  // System Limits
  maxUsers    Int @default(3)
  maxProducts Int @default(100)

  // Current Usage Metrics
  usedStorage   BigInt @default(0) // Total en bytes ocupados
  totalProducts Int    @default(0) // Cantidad actual de productos registrados
  totalUsers    Int    @default(0) // Cantidad actual de usuarios (sincronizado desde servicio externo)
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  NEVER
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  priceCost   Decimal @db.Decimal(10, 2)
  stock       Int     @default(0)
  minStock    Int     @default(0)
  code        String  @default("TEMP-CODE") // Mínimo de stock para alertas
  societyId   String
  society     Society @relation(fields: [societyId], references: [id])

  // Identification & Characteristics
  barcode         String? // EAN-13, UPC
  brand           String?
  unitOfMeasure   String         @default("NIU") // NIU = Unidad (Deprecating in favor of relation)
  unitOfMeasureId String?
  UnitOfMeasure   UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id])
  color           String? // Característica de productos
  colorCode       String? // Referencia del color escrito

  imageId String?
  image   File?   @relation(fields: [imageId], references: [id])

  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // [NEW] Metrics
  salesCount Int @default(0) // Contador de ventas totales

  BranchOfficeProduct BranchOfficeProduct[]

  PurchaseDetail PurchaseDetail[]

  ProductBranchMovement ProductBranchMovement[]

  OrderItem OrderItem[]

  DeliveredConsignmentAgreement DeliveredConsignmentAgreement[]
  inventoryTransactions         InventoryTransaction[]

  favorites Favorite[]

  @@unique([societyId, code])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  code        String
  description String?
  products    Product[] // Relación uno a muchos con productos
  societyId   String
  society     Society   @relation(fields: [societyId], references: [id])
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?

  @@unique([societyId, code])
}

model Favorite {
  id        String @id @default(uuid())
  productId String
  userId    String // ID del usuario (puede ser BusinessPartner o Usuario del sistema)
  societyId String

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  society Society @relation(fields: [societyId], references: [id])

  @@unique([productId, userId, societyId]) // Evitar duplicados por usuario/producto/sociedad
}

model UnitOfMeasure {
  id           String  @id @default(uuid())
  name         String // Nombre de la unidad (e.g. Kilogramos)
  abbreviation String // Abreviatura (e.g. kg)
  sunatCode    String // Código SUNAT (e.g. KGM)
  isActive     Boolean @default(true)
  isDeleted    Boolean @default(false)

  // Tenants
  societyId String
  society   Society @relation(fields: [societyId], references: [id])

  code String // Código interno único por sociedad (ej: KGM, NIU)

  // Relations
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([societyId, code])
}

model BranchOffice {
  id      String  @id @default(uuid())
  name    String
  address String?
  phone   String?
  isMain  Boolean @default(false)

  societyId String
  society   Society @relation(fields: [societyId], references: [id])

  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  code      String? // Código interno de la sucursal
  email     String? // Email de contacto
  ubigeoId  String?  @db.Char(6)

  ubigeo UbigeoPeru? @relation(fields: [ubigeoId], references: [id])

  BranchOfficeProduct BranchOfficeProduct[]

  outgoingMovements ProductBranchMovement[] @relation("OriginBranch")
  incomingMovements ProductBranchMovement[] @relation("DestinationBranch")

  Order Order[]

  OutgoingConsignmentAgreement OutgoingConsignmentAgreement[]

  DeliveredConsignmentAgreement DeliveredConsignmentAgreement[]
  purchases                     Purchase[]
  cashShifts                    CashShift[]
  inventoryTransactions         InventoryTransaction[]

  @@unique([societyId, code])
}

model BranchOfficeProduct {
  id             String @id @default(uuid())
  productId      String
  branchOfficeId String

  availableStock Int     @default(0)
  physicalStock  Int     @default(0) // Stock físico real
  reservedStock  Int     @default(0) // Stock comprometido/reservado
  defectiveStock Int     @default(0) // Stock defectuoso/merma
  location       String? // Ubicación en almacén (ej: A-01-05)
  isActive       Boolean @default(true)
  isDeleted      Boolean @default(false)

  minStock        Int? // stock mínimo para alertas
  maxStock        Int? // stock máximo de referencia
  lastRestockedAt DateTime? // fecha del último ingreso de stock

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  product           Product            @relation(fields: [productId], references: [id])
  branchOffice      BranchOffice       @relation(fields: [branchOfficeId], references: [id])
  bussinessPartners BussinessPartner[]

  @@unique([productId, branchOfficeId]) // evita duplicados por producto/sucursal
}

model Purchase {
  id String @id @default(uuid())

  societyId  String // empresa que realiza la compra
  providerId String // proveedor (BusinessPartner)

  purchaseDate DateTime       @default(now())
  status       PurchaseStatus @default(PENDING)

  // totalAmount moved down to group with financials

  notes         String? // observaciones generales de la compra
  purchaseCode  String? // código interno o número de orden
  paymentMethod String? // opcional: efectivo, transferencia, crédito
  dueDate       DateTime? // si se compró a crédito, fecha de vencimiento

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  society  Society          @relation(fields: [societyId], references: [id])
  provider BussinessPartner @relation(fields: [providerId], references: [id])

  // [NEW] Financials
  currencyId   String
  currency     Currency @relation(fields: [currencyId], references: [id])
  exchangeRate Decimal  @default(1.0) @db.Decimal(10, 4)

  subTotal    Decimal @default(0.0) @db.Decimal(10, 2)
  taxAmount   Decimal @default(0.0) @db.Decimal(10, 2)
  totalAmount Decimal @default(0.0) @db.Decimal(10, 2) // Kept existing field

  taxId String?
  tax   Tax?    @relation(fields: [taxId], references: [id])

  // [NEW] Documentation
  documentTypeId String?
  documentType   ReceiptType? @relation(fields: [documentTypeId], references: [id])
  documentNumber String?

  // [NEW] Logistics
  branchOfficeId String
  branchOffice   BranchOffice @relation(fields: [branchOfficeId], references: [id])

  purchaseDetails PurchaseDetail[] // relación con detalle de productos comprados
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  REJECTED
}

model PurchaseDetail {
  id         String @id @default(uuid())
  purchaseId String
  productId  String

  quantity  Int
  unitPrice Decimal
  subtotal  Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  // [NEW] Financial breakdown per line
  taxAmount Decimal @default(0.0) @db.Decimal(10, 2)
  total     Decimal @default(0.0) @db.Decimal(10, 2) // subtotal + tax

  // [NEW] Logistics
  receivedQuantity Int       @default(0)
  expirationDate   DateTime? // Fecha de vencimiento del lote
}

model ProductBranchMovement {
  id String @id @default(uuid())

  originBranchId      String // Sucursal de origen
  destinationBranchId String // Sucursal de destino
  productId           String // Producto movido

  quantityMoved Int // Cantidad trasladada
  movementDate  DateTime       @default(now())
  notes         String? // Comentarios, justificación del movimiento
  referenceCode String? // Código interno o guía de traslado
  status        MovementStatus @default(PENDING) // Estado del movimiento

  // Audit
  batchId            String? // Grouping for bulk transfers
  receivedAt         DateTime? // Confirmation time
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  originBranch      BranchOffice @relation("OriginBranch", fields: [originBranchId], references: [id])
  destinationBranch BranchOffice @relation("DestinationBranch", fields: [destinationBranchId], references: [id])
  product           Product      @relation(fields: [productId], references: [id])
}

enum MovementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Order {
  id                 String      @id @default(uuid())
  orderCode          String      @unique
  orderDate          DateTime    @default(now())
  totalAmount        Decimal     @default(0.0)
  status             OrderStatus @default(PENDING)
  discount           Decimal     @default(0.0)
  notes              String?
  paymentDate        DateTime?
  comment            String?
  cancellationReason String?

  // Financial Breakdown
  subtotal  Decimal @default(0.0)
  taxAmount Decimal @default(0.0)

  // Currency
  currencyId   String
  currency     Currency @relation(fields: [currencyId], references: [id])
  exchangeRate Decimal  @default(1.0) @db.Decimal(10, 4)

  // Logistics
  deliveryDate    DateTime?
  shippingAddress String?

  // Relacionales
  societyId String
  partnerId String
  branchId  String

  society Society          @relation(fields: [societyId], references: [id])
  partner BussinessPartner @relation(fields: [partnerId], references: [id])
  branch  BranchOffice     @relation(fields: [branchId], references: [id])

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  // Relaciones adicionales
  orderItems   OrderItem[]
  OrderPayment OrderPayment[]
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  COMPLETED
  CANCELLED
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int

  // Pricing & Financials
  unitPrice Decimal @db.Decimal(10, 2)
  costPrice Decimal @default(0.0) @db.Decimal(10, 2) // Snapshot del costo

  subtotal  Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0.0) @db.Decimal(10, 2)
  taxAmount Decimal @default(0.0) @db.Decimal(10, 2) // Referencia del impuesto (ej: IGV) para facturación
  total     Decimal @default(0.0) @db.Decimal(10, 2) // subtotal - discount + tax

  // Operational
  comment String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model OrderPayment {
  id           String   @id @default(uuid())
  orderId      String?
  // Financials
  amount       Decimal  @db.Decimal(10, 2)
  currencyId   String
  currency     Currency @relation(fields: [currencyId], references: [id])
  exchangeRate Decimal  @default(1.0) @db.Decimal(10, 4)

  paymentDate   DateTime           @default(now())
  paymentMethod PaymentMethodOrder

  // Status & Evidence
  status        PaymentStatus @default(PENDING)
  referenceCode String? // Referencia de transferencia o número de operación
  imageId       String?
  image         File?         @relation(fields: [imageId], references: [id])

  notes       String? // Observaciones del pago
  // isConfirmed Boolean @default(false) // DEPRECATED: Use status instead
  confirmedAt DateTime? // Fecha de confirmación (si aplica)

  societyId String

  // Relaciones
  order   Order?  @relation(fields: [orderId], references: [id])
  society Society @relation(fields: [societyId], references: [id])

  // Auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  SocietyReceipt SocietyReceipt[]

  ReceivedConsignmentSettlement ReceivedConsignmentSettlement[]

  cashMovement CashMovement?
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum PaymentMethodOrder {
  CASH
  CARD
  TRANSFER
  YAPE
  PLIN
  OTHER
}

model SocietyReceipt {
  id String @id @default(uuid())

  societyId String
  society   Society @relation(fields: [societyId], references: [id])

  orderPaymentId String

  fileId    String? // PDF
  xmlFileId String? // XML/CDR

  series        String // Serie del comprobante (ej: F001)
  receiptNumber String // Número correlativo del comprobante
  issueDate     DateTime // Fecha de emisión del comprobante

  subTotal    Decimal // Base Imponible
  taxAmount   Decimal // IGV
  totalAmount Decimal // Monto total del comprobante
  status      ReceiptStatus @default(issued)

  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])

  taxId String
  tax   Tax    @relation(fields: [taxId], references: [id])

  receiptTypeId String
  receiptType   ReceiptType @relation(fields: [receiptTypeId], references: [id])

  // Relación con el pago
  orderPayment OrderPayment @relation(fields: [orderPaymentId], references: [id])
  file         File?        @relation("ReceiptPdf", fields: [fileId], references: [id])
  xmlFile      File?        @relation("ReceiptXml", fields: [xmlFileId], references: [id])

  // Auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([societyId, receiptTypeId, series, receiptNumber])
}

model OutgoingConsignmentAgreement {
  id        String @id @default(uuid())
  societyId String
  branchId  String
  partnerId String

  startDate      DateTime // Fecha de inicio del acuerdo
  endDate        DateTime // Fecha de término del acuerdo
  commissionRate Decimal // Porcentaje de comisión aplicado (ej: 0.15 = 15%)

  agreementCode String?           @unique // Código único del acuerdo
  status        ConsignmentStatus @default(ACTIVE)

  notes String? // Comentarios adicionales o condiciones especiales

  // [NEW] Financials
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])

  totalValue  Decimal  @default(0.0) @db.Decimal(10, 2)
  creditLimit Decimal? @db.Decimal(10, 2) // Límite de crédito opcional

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  // Relaciones
  society Society          @relation(fields: [societyId], references: [id])
  branch  BranchOffice     @relation(fields: [branchId], references: [id])
  partner BussinessPartner @relation(fields: [partnerId], references: [id])

  DeliveredConsignmentAgreement DeliveredConsignmentAgreement[]

  ReceivedConsignmentSettlement ReceivedConsignmentSettlement[]
}

enum ConsignmentStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
}

model DeliveredConsignmentAgreement {
  id                     String @id @default(uuid())
  consignmentAgreementId String
  productId              String
  branchId               String

  deliveredStock Int // Stock entregado al inicio
  remainingStock Int? // Stock restante (actualizado al vender o devolver)

  // [CHANGE] Use Decimal for money!
  costPrice          Decimal @db.Decimal(10, 2)
  suggestedSalePrice Decimal @db.Decimal(10, 2)

  // [NEW] Computed values for easy reporting
  totalCost  Decimal @default(0.0) @db.Decimal(10, 2) // Inventory Value
  totalValue Decimal @default(0.0) @db.Decimal(10, 2) // Retail Value

  // [NEW] Tax
  taxAmount    Decimal  @default(0.0) @db.Decimal(10, 2)
  deliveryDate DateTime @default(now()) // Fecha en la que se entregó el producto
  status       String   @default("active") // Estado: active, returned, sold_out, etc.
  notes        String? // Comentarios o detalles adicionales

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  consignmentAgreement OutgoingConsignmentAgreement @relation(fields: [consignmentAgreementId], references: [id])
  product              Product                      @relation(fields: [productId], references: [id])
  branch               BranchOffice                 @relation(fields: [branchId], references: [id])

  ExternalConsignmentSale ExternalConsignmentSale[]
}

model ExternalConsignmentSale {
  id                     String @id @default(uuid())
  deliveredConsignmentId String

  soldQuantity     Int // Cantidad vendida por el consignatario
  reportedSaleDate DateTime // Fecha de la venta reportada

  // [CHANGE] Use Decimal for money
  reportedSalePrice     Decimal  @db.Decimal(10, 2) // Total reported
  unitSalePrice         Decimal  @db.Decimal(10, 2)
  totalCommissionAmount Decimal? @default(0.0) @db.Decimal(10, 2)

  // [NEW] Computed
  netTotal          Decimal @default(0.0) @db.Decimal(10, 2) // reportedSalePrice - commission
  remarks           String? // Comentarios del consignatario o notas adicionales
  documentReference String? // Referencia a factura u otro comprobante externo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  deliveredConsignment DeliveredConsignmentAgreement @relation(fields: [deliveredConsignmentId], references: [id])
}

model ReceivedConsignmentSettlement {
  id                  String  @id @default(uuid())
  outgoingAgreementId String
  orderPaymentId      String?

  settlementDate DateTime // Fecha de la liquidación

  // [CHANGE] Use Decimal for money
  totalReportedSalesAmount  Decimal @db.Decimal(10, 2)
  consigneeCommissionAmount Decimal @db.Decimal(10, 2)
  totalReceivedAmount       Decimal @db.Decimal(10, 2)

  status SettlementStatus @default(PENDING) // Estado: PENDING, PAID

  receiptReference String? // Número de referencia del recibo
  settlementNotes  String? // Notas adicionales o comentarios del proceso

  // [CHANGE] Link to Currency model
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  outgoingAgreement OutgoingConsignmentAgreement @relation(fields: [outgoingAgreementId], references: [id])
  orderPayment      OrderPayment?                @relation(fields: [orderPaymentId], references: [id])
}

enum SettlementStatus {
  PENDING
  PAID
}

model UbigeoPeru {
  id                String             @id @map("ubigeo_id") @db.Char(6)
  department        String             @db.VarChar(100)
  province          String             @db.VarChar(100)
  district          String             @db.VarChar(100)
  naturalRegion     String?            @db.VarChar(50)
  region            String?            @db.VarChar(50)
  latitude          Decimal?           @db.Decimal(9, 6)
  longitude         Decimal?           @db.Decimal(9, 6)
  branchOffices     BranchOffice[]
  bussinessPartners BussinessPartner[]

  @@map("UbigeoPeru")
}

// ------------------------------------
// Cash Shift / Sesiones de Caja
// ------------------------------------

enum ShiftStatus {
  OPEN
  CLOSED
}

enum MovementType {
  INCOME
  EXPENSE
}

model CashShift {
  id String @id @default(uuid())

  societyId String
  branchId  String
  userId    String // ID del cajero (No relation due to external user management)

  status   ShiftStatus @default(OPEN)
  openedAt DateTime    @default(now())
  closedAt DateTime?

  initialAmount Decimal @db.Decimal(10, 2) // Sencillo inicial

  // Cierre
  finalReportedAmount Decimal? @db.Decimal(10, 2)
  finalSystemAmount   Decimal? @db.Decimal(10, 2)
  difference          Decimal? @db.Decimal(10, 2)

  // Acumulados Snapshots (calculados al cierre)
  incomeCash     Decimal @default(0) @db.Decimal(10, 2)
  incomeCard     Decimal @default(0) @db.Decimal(10, 2)
  incomeYape     Decimal @default(0) @db.Decimal(10, 2)
  incomePlin     Decimal @default(0) @db.Decimal(10, 2)
  incomeTransfer Decimal @default(0) @db.Decimal(10, 2)
  expenseCash    Decimal @default(0) @db.Decimal(10, 2)

  observations String? @db.Text

  // Reportes físicos por método (opcionales para conciliación detallada)
  reportedCashAmount     Decimal? @db.Decimal(10, 2)
  reportedCardAmount     Decimal? @db.Decimal(10, 2)
  reportedYapeAmount     Decimal? @db.Decimal(10, 2)
  reportedPlinAmount     Decimal? @db.Decimal(10, 2)
  reportedTransferAmount Decimal? @db.Decimal(10, 2)

  movements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society      @relation(fields: [societyId], references: [id])
  branch  BranchOffice @relation(fields: [branchId], references: [id])
}

model CashMovement {
  id      String @id @default(uuid())
  shiftId String

  type         MovementType // INCOME, EXPENSE
  amount       Decimal      @db.Decimal(10, 2)
  currencyId   String
  exchangeRate Decimal      @default(1.0) @db.Decimal(10, 4)

  paymentMethod PaymentMethodOrder

  description String?

  orderPaymentId String? @unique

  createdAt DateTime @default(now())
  createdBy String?

  shift        CashShift     @relation(fields: [shiftId], references: [id])
  currency     Currency      @relation(fields: [currencyId], references: [id])
  orderPayment OrderPayment? @relation(fields: [orderPaymentId], references: [id])
}

// ------------------------------------
// KARDEX (Centralized Inventory)
// ------------------------------------

model InventoryTransaction {
  id   String   @id @default(uuid())
  date DateTime @default(now())

  productId      String
  branchOfficeId String

  type          TransactionType
  quantity      Int // + for IN, - for OUT
  previousStock Int
  newStock      Int // The snapshot of stock AFTER this movement

  // Costos Snapshot (Kardex Valorado)
  unitCost  Decimal @db.Decimal(10, 2)
  totalCost Decimal @db.Decimal(10, 2)

  // Trazabilidad
  referenceId    String? // ID of Purchase, Order, etc.
  referenceType  String? // 'PURCHASE', 'ORDER', 'TRANSFER_IN', 'TRANSFER_OUT', 'ADJUSTMENT'
  documentNumber String? // Optional external doc ref

  // Relations
  product      Product      @relation(fields: [productId], references: [id])
  branchOffice BranchOffice @relation(fields: [branchOfficeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
}

enum TransactionType {
  PURCHASE_ENTRY
  SALE_EXIT
  TRANSFER_OUT
  TRANSFER_IN
  CONSIGNMENT_OUT
  CONSIGNMENT_RETURN
  ADJUSTMENT_ADD
  ADJUSTMENT_SUB
}
